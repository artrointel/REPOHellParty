<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HellParty</AssemblyName>
    <RootNamespace>HellParty</RootNamespace>
    <Authors>artrointel</Authors>
    <Version>0.2.1</Version>
    <Description>Host-only stage difficulty and monster abilities for R.E.P.O.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyFilesToPluginOutputDirectoryOnBuild>false</CopyFilesToPluginOutputDirectoryOnBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <HellPartyTestScenario Condition="'$(HellPartyTestScenario)' == ''">None</HellPartyTestScenario>
    <!-- Compile against the installed 0.5 game, not stale NuGet game stubs. -->
    <HellPartyManagedDirectory Condition="'$(HellPartyManagedDirectory)' == ''">$([System.IO.Path]::Combine('$(GameDirectory)', 'REPO_Data', 'Managed'))</HellPartyManagedDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(HellPartyTestScenario)' == 'CleanupCrew'">
    <DefineConstants>$(DefineConstants);HELLPARTY_TEST_CLEANUP_CREW</DefineConstants>
    <OutputPath>bin\$(Configuration)\Scenarios\$(HellPartyTestScenario)\</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug' or '$(HellPartyTestScenario)' != 'CleanupCrew'">
    <Compile Remove="Debugging\**\*.cs" />
  </ItemGroup>

  <Target Name="ValidateHellPartyTestScenario" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HellPartyTestScenario)' != 'None' and '$(HellPartyTestScenario)' != 'CleanupCrew'" Text="Unknown HellPartyTestScenario. Use None or CleanupCrew." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(HellPartyTestScenario)' != 'None'" Text="HellParty test scenarios require a Debug build." />
  </Target>

  <Target Name="ValidateInstalledGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HellPartyManagedDirectory)\Assembly-CSharp.dll')" Text="Install R.E.P.O. 0.5.0 and set GameDirectory in Directory.Repo.props (or HellPartyManagedDirectory). Installed game references are required." />
  </Target>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="Linkoid.Repo.Plugin.Build" Version="0.2.2" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <_InstalledGameReference Include="$(HellPartyManagedDirectory)\Assembly-CSharp.dll;$(HellPartyManagedDirectory)\Assembly-CSharp-firstpass.dll;$(HellPartyManagedDirectory)\UnityEngine*.dll;$(HellPartyManagedDirectory)\Unity.TextMeshPro.dll;$(HellPartyManagedDirectory)\Photon*.dll;$(HellPartyManagedDirectory)\Facepunch.Steamworks.Win64.dll;$(HellPartyManagedDirectory)\Klattersynth.dll" />
    <Reference Include="@(_InstalledGameReference)" Private="false" />
    <Publicize Include="Assembly-CSharp" PublicizeTarget="All" PublicizeCompilerGenerated="false" IncludeOriginalAttributesAttribute="false" Strip="true" />
  </ItemGroup>
</Project>
